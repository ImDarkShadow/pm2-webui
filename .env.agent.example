# ==============================================================================
# PM2 Web UI — Remote Worker Agent Configuration
# ==============================================================================

# Master WebSocket / HTTP URL (Required to connect to master)
MASTER_WS_URL=http://master-server-ip:3005

# Pre-Shared Cluster Join Token (Optional: Auto-enrolls without manual UI approval)
JOIN_TOKEN=your-pre-shared-cluster-join-secret

# Node Hostname & Embedded Direct Telemetry Port
AGENT_HOSTNAME=worker-node-01
AGENT_PORT=4321

# Local Persistent Storage & Application Working Root
AGENT_DATA_DIR=/root/.pm2-webui/agent

# Telemetry Collection & Retention Settings
METRICS_INTERVAL_MS=3000
LOG_RETENTION_DAYS=7
METRICS_RETENTION_DAYS=30
