# ==============================================================================
# PM2 Cluster Manager — Master Server Configuration
# ==============================================================================

# Server Environment & Listening Port
NODE_ENV=production
PORT=3005

# Master Persistent Storage Directory (SQLite DB & Cache)
MASTER_DATA_DIR=/root/.pm2-cluster/master

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=replace-with-a-random-secure-secret-32-chars-minimum

# Initial Administrator Account (Provisioned on first start)
ADMIN_USER=admin
ADMIN_EMAIL=admin@pm2-cluster.local
ADMIN_PASSWORD=adminpassword123

# Pre-Shared Cluster Join Token for Automatic Node Enrollment (Optional)
# When set, remote agents presenting this token are auto-approved to 'online' status
CLUSTER_JOIN_TOKEN=your-pre-shared-cluster-join-secret
