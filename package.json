{
  "name": "pm2-webui",
  "version": "1.1.1",
  "description": "Modern multi-node PM2 cluster management dashboard and real-time control plane",
  "type": "module",
  "bin": {
    "pm2-webui": "./bin/pm2-webui.js"
  },
  "author": "ImDarkShadow",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImDarkShadow/pm2-webui.git"
  },
  "bugs": {
    "url": "https://github.com/ImDarkShadow/pm2-webui/issues"
  },
  "homepage": "https://github.com/ImDarkShadow/pm2-webui#readme",
  "keywords": [
    "pm2",
    "webui",
    "dashboard",
    "cluster",
    "monitoring",
    "process-manager",
    "devops"
  ],
  "files": [
    "bin",
    "packages/master/dist",
    "packages/master/package.json",
    "packages/agent-core/dist",
    "packages/agent-core/package.json",
    "packages/shared/dist",
    "packages/shared/package.json",
    "packages/web/dist",
    "packages/web/package.json",
    "LICENSE",
    "README.md",
    "logo-light.svg",
    "logo-dark.svg"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "pm2": "^7.0.4",
    "systeminformation": "^5.25.11",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "oxlint": "^1.79.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@node-rs/argon2"
    ],
    "overrides": {
      "@fastify/static": "^10.1.3",
      "js-yaml": "^4.3.1",
      "pm2": "^7.0.4"
    }
  },
  "packageManager": "pnpm@10.23.0"
}
