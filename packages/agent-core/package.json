    "test": "vitest run"
  },
  "dependencies": {
    "@pm2-cluster/shared": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "pino": "^9.6.0",
    "pm2": "^5.4.3",
    "systeminformation": "^5.25.11",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
